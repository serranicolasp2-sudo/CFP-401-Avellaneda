# =============================================================================
# CFP N° 401 AVELLANEDA — PROTECCIÓN CARPETA ASSETS
# =============================================================================
# Desactivar listado de directorios
Options -Indexes

# Desactivar motores de ejecución PHP para evitar ejecución de scripts maliciosos
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

# En servidores con php-fpm o handler FastCGI, denegar ejecución de scripts
<FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|cgi|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
